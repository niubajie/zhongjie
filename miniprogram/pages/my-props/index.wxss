.my-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  background: #f8fafc;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
  font-size: 26rpx;
  color: #475569;
}

.tab.on {
  border-color: #2563eb;
  background: #2563eb;
  color: #fff;
}

.state {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 21rpx;
}

.badge-active {
  background: #dcfce7;
  color: #15803d;
}

.badge-pending,
.badge-stale {
  background: #fef3c7;
  color: #b45309;
}

.badge-rented {
  background: #e2e8f0;
  color: #475569;
}

.card-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.card-meta {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

.tip {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.actions button {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.ghost {
  background: #eff6ff;
  color: #1d4ed8;
}

.danger {
  background: #fee2e2;
  color: #b91c1c;
}
