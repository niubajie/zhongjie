<view class="property-page">
  <view class="hero">
    <text class="hero-label">房源图片</text>
    <text class="hero-count">共 {{imageCount}} 张</text>
  </view>

  <view class="content" wx:if="{{detail}}">
    <text class="title">{{detail.title}}</text>
    <text class="location">{{detail.districtName || detail.districtCode}} · {{detail.streetName || detail.streetCode}}（仅展示区/街道）</text>


    <view class="metrics">
      <view class="metric">
        <text class="metric-value">{{detail.areaSqm}}㎡</text>
        <text class="metric-label">面积</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{rentYuan}}</text>
        <text class="metric-label">月租</text>
      </view>
      <view class="metric" wx:if="{{detail.layout}}">
        <text class="metric-value">{{detail.layout}}</text>
        <text class="metric-label">户型</text>
      </view>
      <view class="metric" wx:if="{{detail.floor}}">
        <text class="metric-value">{{detail.floor}}</text>
        <text class="metric-label">楼层</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">房源描述</text>
      <text class="section-body">{{detail.description || '暂无描述'}}</text>
    </view>

    <view class="section">
      <text class="section-title">位置说明</text>
      <text class="section-body">为保护房东隐私，公开页面只展示区和街道；具体位置在联系确认后由房东告知。</text>
    </view>

    <button class="primary-btn contact" bindtap="onContact" disabled="{{contactLoading}}">
      {{contactLoading ? '提交中…' : '联系房东'}}
    </button>
  </view>

  <view class="state" wx:if="{{loading}}">加载中…</view>
  <view class="state" wx:if="{{error}}">{{error}}</view>
</view>
