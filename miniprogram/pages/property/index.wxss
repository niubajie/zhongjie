.property-page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 48rpx;
}

.hero {
  position: relative;
  height: 380rpx;
  background: linear-gradient(135deg, #dbeafe, #ede9fe 55%, #fce7f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-wrap {
  position: relative;
  height: 380rpx;
}

.hero-image {
  width: 100%;
  height: 380rpx;
  display: block;
}

.section-video {
  width: 100%;
  height: 400rpx;
  margin-top: 14rpx;
  border-radius: 18rpx;
}

.hero-label {
  font-size: 30rpx;
  color: #475569;
}

.hero-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(15, 23, 42, 0.7);
  color: #fff;
  font-size: 22rpx;
}

.content {
  padding: 28rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.location {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.metric {
  flex: 1;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  text-align: center;
}

.metric-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #64748b;
}

.section {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.section-body {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #334155;
}

.contact {
  margin-top: 32rpx;
}

.state {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}
