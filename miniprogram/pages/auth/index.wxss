.auth-page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: radial-gradient(circle at 20% 0%, #dbeafe 0, #f8fafc 42%, #f8fafc 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(37, 99, 235, 0.28);
}

.brand-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.brand-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #64748b;
}

.steps {
  display: flex;
  gap: 10rpx;
  margin-top: 36rpx;
}

.step {
  flex: 1;
  padding: 12rpx 8rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
  color: #64748b;
  font-size: 21rpx;
  text-align: center;
}

.step-active {
  background: #2563eb;
  color: #fff;
}

.panel {
  margin-top: 28rpx;
  padding: 30rpx 26rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
}

.panel-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.panel-sub {
  display: block;
  margin: 12rpx 0 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.dev-btn {
  margin-top: 16rpx;
  color: #2563eb;
  border-color: #bfdbfe;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #334155;
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  font-size: 28rpx;
}

.role-group {
  display: flex;
  gap: 12rpx;
}

.role {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  font-size: 24rpx;
  color: #334155;
}

.role-active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
}

.message {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #dc2626;
}

.privacy {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #94a3b8;
}
