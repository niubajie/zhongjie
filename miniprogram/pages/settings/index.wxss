.settings-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  background: #f8fafc;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.row-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.row-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

.hint {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

.field-input {
  width: 100%;
  height: 80rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
}

.message {
  display: block;
  margin: 20rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #dc2626;
}

.privacy {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
}
