.import-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  background: #f8fafc;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.panel {
  margin-top: 26rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
}

.file {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #eff6ff;
}

.file-name {
  display: block;
  font-size: 26rpx;
  color: #1d4ed8;
}

.file-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #64748b;
}

.upload {
  margin-top: 18rpx;
}

.hint {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.result-grid {
  display: flex;
  gap: 12rpx;
}

.result-grid > view {
  flex: 1;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  text-align: center;
}

.result-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.result-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.error {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: #dc2626;
}
