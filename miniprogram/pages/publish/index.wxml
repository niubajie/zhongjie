<view class="publish-page">
  <view class="head">
    <view class="head-row">
      <text class="title">发布房源</text>
      <view class="head-actions">
        <button class="settings-link" bindtap="onImport">导入文档</button>
        <button class="settings-link" bindtap="onSettings">联系方式</button>
      </view>
    </view>
    <text class="sub">选择小区，填写面积和月租；小区核验通过后自动上架。</text>
  </view>

  <view class="panel" wx:if="{{!canPublish}}">
    <text class="panel-title">需要房东身份</text>
    <text class="panel-sub">{{message || '请先登录并切换为房东身份。'}}</text>
  </view>

  <view class="panel" wx:if="{{canPublish}}">
    <view class="field">
      <text class="field-label">小区</text>
      <input
        class="field-input"
        value="{{keyword}}"
        placeholder="输入小区名，例如：海岸城花园"
        bindinput="onKeywordInput"
      />
      <text class="hint" wx:if="{{searching}}">搜索中…</text>
      <view class="suggestions" wx:if="{{suggestions.length > 0 && !selected}}">
        <button
          class="suggestion"
          wx:for="{{suggestions}}"
          wx:key="uuid"
          data-uuid="{{item.uuid}}"
          bindtap="onSelectCommunity"
        >
          <text class="suggestion-name">{{item.name}}</text>
          <text class="suggestion-meta">{{item.districtName}} · {{item.streetName}}</text>
        </button>
      </view>
      <view class="selected" wx:if="{{selected}}">
        <text class="selected-name">{{selected.name}}</text>
        <text class="selected-meta">已选择 · {{selected.communityType === 'apartment' ? '公寓' : '住宅小区'}}</text>
      </view>
    </view>

    <view class="row">
      <view class="field half">
        <text class="field-label">面积（㎡）</text>
        <input class="field-input" type="digit" value="{{area}}" placeholder="例如 120" bindinput="onAreaInput" />
      </view>
      <view class="field half">
        <text class="field-label">月租（元）</text>
        <input class="field-input" type="digit" value="{{rentYuan}}" placeholder="例如 16800" bindinput="onRentInput" />
      </view>
    </view>

    <view class="row">
      <view class="field half">
        <text class="field-label">户型</text>
        <input class="field-input" value="{{layout}}" placeholder="3+1" bindinput="onLayoutInput" />
      </view>
      <view class="field half">
        <text class="field-label">楼层</text>
        <input class="field-input" value="{{floor}}" placeholder="12/30" bindinput="onFloorInput" />
      </view>
    </view>

    <view class="field">
      <text class="field-label">朝向</text>
      <input class="field-input" value="{{orientation}}" placeholder="南 / 东南" bindinput="onOrientationInput" />
    </view>

    <view class="field">
      <text class="field-label">标题（可选）</text>
      <input class="field-input" value="{{title}}" maxlength="80" placeholder="不填会自动生成" bindinput="onTitleInput" />
    </view>

    <view class="field">
      <text class="field-label">描述（可选）</text>
      <textarea class="field-textarea" value="{{description}}" maxlength="2000" placeholder="采光、装修、交通等" bindinput="onDescriptionInput" />
    </view>

    <text class="message" wx:if="{{message}}">{{message}}</text>

    <button class="primary-btn" bindtap="onSubmit" disabled="{{loading}}">
      {{loading ? '发布中…' : '发布房源'}}
    </button>
    <text class="privacy">公开页面只展示区/街道；小区名仅用于核验，不对外展示。</text>
  </view>
</view>
