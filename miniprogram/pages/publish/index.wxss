.publish-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  background: #f8fafc;
}

.head {
  margin-bottom: 26rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.settings-link {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 21rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.panel {
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
}

.panel-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.panel-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.field {
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.field-input,
.field-textarea {
  width: 100%;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 27rpx;
}

.field-input {
  height: 82rpx;
  padding: 0 18rpx;
}

.field-textarea {
  height: 160rpx;
  padding: 16rpx 18rpx;
}

.hint {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #94a3b8;
}

.suggestions {
  margin-top: 10rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  overflow: hidden;
}

.suggestion {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: 16rpx 18rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
  text-align: left;
}

.suggestion:last-child {
  border-bottom: 0;
}

.suggestion-name {
  font-size: 26rpx;
  color: #0f172a;
}

.suggestion-meta {
  font-size: 21rpx;
  color: #94a3b8;
}

.selected {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}

.selected-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.selected-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #3b82f6;
}

.message {
  display: block;
  margin: 8rpx 0 18rpx;
  text-align: center;
  font-size: 23rpx;
  color: #dc2626;
}

.privacy {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
}
